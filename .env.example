# Copy to .env and adjust values before running docker compose.
# cp .env.example .env

# ── PostgreSQL (docker-compose db service) ────────────────────────────────────
POSTGRES_DB=inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=inventory_pass

# ── Backend ───────────────────────────────────────────────────────────────────
APP_NAME=Inventory Management API
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app
LOW_STOCK_THRESHOLD=10

# ── Frontend build arg ───────────────────────────────────────────────────────
# Docker Compose (recommended): nginx proxies /api → backend, use relative URL:
VITE_API_URL=/api/v1
#
# Local Vite dev (npm run dev): point directly at backend:
# VITE_API_URL=http://localhost:8000/api/v1

# ── Production deployment examples ───────────────────────────────────────────
# Render/Railway backend URL (set on Vercel/Netlify as VITE_API_URL):
# VITE_API_URL=https://your-backend.onrender.com/api/v1
