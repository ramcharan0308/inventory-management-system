# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://inventory_user:inventory_pass@localhost:5432/inventory_db

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Inventory & Order Management System
APP_VERSION=1.0.0
DEBUG=false

# ── CORS (comma-separated origins) ────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ── Business rules ────────────────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=10
